# Get an API key from https://console.groq.com/keys
GROQ_API_KEY=
# Check https://console.groq.com/docs/models for currently available model IDs.
# This default supports Groq's documented structured-output examples; change it if unavailable to your account.
GROQ_MODEL=openai/gpt-oss-20b
# Set false to run without calling Groq (fallback mode is useful for tests/demo).
GROQ_ENABLED=true
